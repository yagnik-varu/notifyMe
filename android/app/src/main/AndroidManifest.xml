<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect that a call is ringing / answered / ended -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Read the caller's number + name from the call log (number source on 10+) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Resolve a contact name from the number (fallback to call log's cached name) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Notification permission prompt on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ask the user to exempt the app from battery optimization so PhoneStateReceiver
         keeps firing when the app is closed (sideloaded APK; not Play-distributed) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Call detector. exported=true because the system sends the broadcast.
           Works across reboots automatically once the app is launched once. -->
      <receiver
          android:name=".PhoneStateReceiver"
          android:enabled="true"
          android:exported="true">
          <intent-filter>
              <action android:name="android.intent.action.PHONE_STATE" />
          </intent-filter>
      </receiver>

      <!-- Caller-ID source: delivers the incoming number at ring time when the app
           holds ROLE_CALL_SCREENING (API 29+). BIND_SCREENING_SERVICE is enforced by
           the system, so no <uses-permission> is needed. -->
      <service
          android:name=".CallScreenService"
          android:permission="android.permission.BIND_SCREENING_SERVICE"
          android:exported="true">
          <intent-filter>
              <action android:name="android.telecom.CallScreeningService" />
          </intent-filter>
      </service>
    </application>
</manifest>
