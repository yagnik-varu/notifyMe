<!--
  AndroidManifest.xml — the app's "declaration" to Android: which permissions it asks
  for and which entry points (activity, receiver, service) the SYSTEM may start.

  Entry points declared here (Android creates these, our code never does):
    .MainApplication          app process start
    .MainActivity             the screen (React Native UI)
    .call.PhoneStateReceiver  phone rang / answered / hung up  → start of every alert
    .call.CallScreenService   caller-ID at ring time (only while we hold the screening role)

  ⚠ GOTCHA: android:name values are class names. Moving a class to another package
  means updating it here, or the app crashes / silently stops receiving events.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect that a call is ringing / answered / ended -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Read the caller's number + name from the call log (number source on 10+) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Resolve a contact name from the number (fallback to call log's cached name) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Notification permission prompt on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ask the user to exempt the app from battery optimization so PhoneStateReceiver
         keeps firing when the app is closed (sideloaded APK; not Play-distributed) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Call detector. exported=true because the system sends the broadcast.
           ⚠ Android won't deliver it until the app has been opened once after install;
           after that it works across reboots automatically. -->
      <receiver
          android:name=".call.PhoneStateReceiver"
          android:enabled="true"
          android:exported="true">
          <intent-filter>
              <action android:name="android.intent.action.PHONE_STATE" />
          </intent-filter>
      </receiver>

      <!-- Caller-ID source: delivers the incoming number at ring time when the app
           holds ROLE_CALL_SCREENING (API 29+). BIND_SCREENING_SERVICE is enforced by
           the system, so no <uses-permission> is needed. -->
      <service
          android:name=".call.CallScreenService"
          android:permission="android.permission.BIND_SCREENING_SERVICE"
          android:exported="true">
          <intent-filter>
              <action android:name="android.telecom.CallScreeningService" />
          </intent-filter>
      </service>

      <!-- Background jobs (call/CallEventWorker, delivery/TestWebhookWorker) don't need
           entries here: WorkManager registers its own components. Note WorkManager saves
           worker class names with queued jobs, so moving a worker class orphans any job
           queued at the moment of the upgrade. -->
    </application>
</manifest>
